# Used when NODE_ENV=production (e.g. `npm run build`).
# Prefer setting these in your deploy provider (Amplify / Elastic Beanstalk / CodeBuild / GitHub Actions)
# so you never commit real prod URLs unless they are public.
#
# Example: single public-facing host + reports under /reports
REACT_APP_API_BASE_URL=https://www.datareconreports.com
REACT_APP_REPORTS_BASE_URL=https://www.datareconreports.com/reports
#
# If API and reports are on different origins in AWS:
# REACT_APP_API_BASE_URL=https://api.your-domain.com
# REACT_APP_REPORTS_BASE_URL=https://reports.your-domain.com
