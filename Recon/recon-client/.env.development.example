# Copy to .env.development.local (gitignored). Used when you run `npm start`.
# For production builds / AWS, use .env.production.local or CI env vars — see .env.production.example and README.
#
# Main API (auth, profile, connections, school routes, etc.)
REACT_APP_API_BASE_URL=http://localhost:4000
#
# Reports API (weekly reports — often a separate port or /reports prefix in prod)
REACT_APP_REPORTS_BASE_URL=http://localhost:4001
#
# Optional: legacy direct reports URL if anything still referenced it explicitly
# REACT_APP_REPORT_URL_AWS=https://www.datareconreports.com:4001
